# Required: random server-to-server secret (32+ characters), shared with backend only.
AI_SERVICE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_VISION_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
RAG_GENERATOR=gemini

# Use a persistent disk for stability across restarts/deployments.
PHOTO_CACHE_PATH=./data/photo-cache.sqlite3
PHOTO_CACHE_VERSION=v1
